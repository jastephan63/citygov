<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:eCH-0133="http://www.ech.ch/xmlns/eCH-0133/3"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:eCH-0129="http://www.ech.ch/xmlns/eCH-0129/6"
	xmlns:eCH-0007="http://www.ech.ch/xmlns/eCH-0007/6"
	xmlns:eCH-0058="http://www.ech.ch/xmlns/eCH-0058/5"
	xmlns:eCH-0097="http://www.ech.ch/xmlns/eCH-0097/2"
	xmlns:eCH-0044="http://www.ech.ch/xmlns/eCH-0044/4"
	targetNamespace="http://www.ech.ch/xmlns/eCH-0133/3" elementFormDefault="qualified"
	attributeFormDefault="unqualified" version="3.0">
	<xs:annotation>
		<xs:documentation>Ausgabedatum: 14.06.2022</xs:documentation>
	</xs:annotation>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0129/6"
		schemaLocation="http://www.ech.ch/xmlns/eCH-0129/6/eCH-0129-6-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0058/5"
		schemaLocation="http://www.ech.ch/xmlns/eCH-0058/5/eCH-0058-5-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0007/6"
		schemaLocation="http://www.ech.ch/xmlns/eCH-0007/6/eCH-0007-6-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0097/2"
		schemaLocation="http://www.ech.ch/xmlns/eCH-0097/2/eCH-0097-2-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0044/4"
		schemaLocation="http://www.ech.ch/xmlns/eCH-0044/4/eCH-0044-4-1.xsd"/>
	<xs:element name="extensions">
		<xs:annotation>
			<xs:documentation>any vendor specifics</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="ownerOrBeneficiaryType">
		<xs:sequence>
			<xs:element name="realestate" type="eCH-0129:realestateType"/>
			<xs:element name="municipality" type="eCH-0007:swissMunicipalityType"/>
			<xs:element name="fiscalOwnershipInformation" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="fiscalOwnership" type="eCH-0129:fiscalOwnershipType"/>
						<xs:element name="personIdentification"
							type="eCH-0129:personIdentificationType"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element ref="eCH-0133:extensions" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="estimationType">
		<xs:sequence>
			<xs:element name="realestateInfo" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="realestate" type="eCH-0129:realestateType"/>
						<xs:element name="municipality" type="eCH-0007:swissMunicipalityType"/>
						<xs:element name="area" type="eCH-0129:areaType" minOccurs="0"
							maxOccurs="unbounded"/>
						<xs:element name="estimationObject" type="eCH-0129:estimationObjectType"
							minOccurs="0"/>
						<xs:element name="buildingInformation" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="building" type="eCH-0129:buildingOnlyType"/>
									<xs:element name="estimationObject"
										type="eCH-0129:estimationObjectType" minOccurs="0"
										maxOccurs="unbounded"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element ref="eCH-0133:extensions" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="realestateBaseDeliveryType">
		<xs:choice>
			<xs:element name="realestateInformation" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="realestate" type="eCH-0129:realestateType"/>
						<xs:element name="municipality" type="eCH-0007:swissMunicipalityType"/>
						<xs:element name="area" type="eCH-0129:areaType" minOccurs="0"
							maxOccurs="unbounded"/>
						<xs:element name="fiscalOwnershipInformation" minOccurs="0"
							maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="fiscalOwnership"
										type="eCH-0129:fiscalOwnershipType"/>
									<xs:element name="personIdentification"
										type="eCH-0129:personIdentificationType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="estimationObject" type="eCH-0129:estimationObjectType"
							minOccurs="0"/>
						<xs:element name="buildingInformation" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="building" type="eCH-0129:buildingOnlyType"/>
									<xs:element name="estimationObject"
										type="eCH-0129:estimationObjectType" minOccurs="0"
										maxOccurs="unbounded"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element ref="eCH-0133:extensions" minOccurs="0"/>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="estimationBaseDeliveryType">
		<xs:choice>
			<xs:element name="estimationInformation" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="estimationObject" type="eCH-0129:estimationObjectType"/>
						<xs:choice>
							<xs:element name="realestateInformation">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="realestate" type="eCH-0129:realestateType"/>
										<xs:element name="municipality"
											type="eCH-0007:swissMunicipalityType"/>
										<xs:element name="area" type="eCH-0129:areaType"
											minOccurs="0" maxOccurs="unbounded"/>
										<xs:element name="fiscalOwnershipInformation" minOccurs="0"
											maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
												<xs:element name="fiscalOwnership"
												type="eCH-0129:fiscalOwnershipType"/>
												<xs:element name="personIdentification"
												type="eCH-0129:personIdentificationType"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="building" type="eCH-0129:buildingOnlyType"
											minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="buildingInformation" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="building" type="eCH-0129:buildingOnlyType"/>
										<xs:element name="realestateInformation" minOccurs="0"
											maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
												<xs:element name="realestate"
												type="eCH-0129:realestateType"/>
												<xs:element name="municipality"
												type="eCH-0007:swissMunicipalityType"/>
												<xs:element name="area" type="eCH-0129:areaType"
												minOccurs="0" maxOccurs="unbounded"/>
												<xs:element name="fiscalOwnershipInformation"
												minOccurs="0" maxOccurs="unbounded">
												<xs:complexType>
												<xs:sequence>
												<xs:element name="fiscalOwnership"
												type="eCH-0129:fiscalOwnershipType"/>
												<xs:element name="personIdentification"
												type="eCH-0129:personIdentificationType"/>
												</xs:sequence>
												</xs:complexType>
												</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:choice>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element ref="eCH-0133:extensions" minOccurs="0"/>
		</xs:choice>
	</xs:complexType>
	<xs:element name="delivery">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="deliveryHeader" type="eCH-0058:headerType"/>
				<xs:choice>
					<xs:element name="ownerOrBeneficiary" type="eCH-0133:ownerOrBeneficiaryType"/>
					<xs:element name="estimation" type="eCH-0133:estimationType"/>
					<xs:element name="realestateBaseDelivery"
						type="eCH-0133:realestateBaseDeliveryType"/>
					<xs:element name="estimationBaseDelivery"
						type="eCH-0133:estimationBaseDeliveryType"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
