<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:eCH-0246="http://www.ech.ch/xmlns/eCH-0246/1" xmlns:eCH-0058="http://www.ech.ch/xmlns/eCH-0058/5" xmlns:eCH-0011="http://www.ech.ch/xmlns/eCH-0011/8" xmlns:eCH-0010="http://www.ech.ch/xmlns/eCH-0010/5" xmlns:eCH-0008="http://www.ech.ch/xmlns/eCH-0008/3" xmlns:eCH-0021="http://www.ech.ch/xmlns/eCH-0021/7" xmlns:eCH-0006="http://www.ech.ch/xmlns/eCH-0006/2" xmlns:eCH-0044="http://www.ech.ch/xmlns/eCH-0044/4" xmlns:eCH-0007="http://www.ech.ch/xmlns/eCH-0007/5" targetNamespace="http://www.ech.ch/xmlns/eCH-0246/1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xs:annotation>
		<xs:documentation>Ausgabedatum:27.07.2020</xs:documentation>
	</xs:annotation>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0011/8" schemaLocation="http://www.ech.ch/xmlns/eCH-0011/8/eCH-0011-8-1.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0010/5" schemaLocation="http://www.ech.ch/xmlns/eCH-0010/5/eCH-0010-5-1.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0008/3" schemaLocation="http://www.ech.ch/xmlns/eCH-0008/3/eCH-0008-3-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0044/4" schemaLocation="http://www.ech.ch/xmlns/eCH-0044/4/eCH-0044-4-1.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0058/5" schemaLocation="http://www.ech.ch/xmlns/eCH-0058/5/eCH-0058-5-0.xsd"/>
	<xs:element name="extension">
		<xs:complexType>
			<xs:sequence>
				<xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="registrationDateType">
		<xs:restriction base="xs:date"/>
	</xs:simpleType>
	<xs:simpleType name="emailAddressType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="100"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+(\.[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+)*@[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+(\.[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+)*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="baseDeliveryType">
		<xs:sequence>
			<xs:element name="person" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="personIdentification" type="eCH-0044:personIdentificationType"/>
						<xs:element name="nameData" type="eCH-0011:nameDataType"/>
						<xs:element name="birthData" type="eCH-0011:birthDataType"/>
						<xs:element name="placeOfOrigin" type="eCH-0011:placeOfOriginType" maxOccurs="unbounded"/>
						<xs:element name="deliveryAddress" type="eCH-0010:mailAddressType"/>
						<xs:element name="residenceCountry" type="eCH-0008:countryType"/>
						<xs:element name="languageOfCorrespondance" type="eCH-0011:languageType" minOccurs="0"/>
						<xs:element name="registrationDate" type="eCH-0246:registrationDateType"/>
						<xs:element name="foreignAgencyAddress" type="eCH-0010:mailAddressType" minOccurs="0"/>
						<xs:element name="emailAddress" type="eCH-0246:emailAddressType" minOccurs="0"/>
						<xs:element ref="eCH-0246:extension" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element ref="eCH-0246:extension" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="votingRightRegistrationType">
		<xs:sequence>
			<xs:element name="personIdentification" type="eCH-0044:personIdentificationType"/>
			<xs:element name="nameData" type="eCH-0011:nameDataType"/>
			<xs:element name="birthData" type="eCH-0011:birthDataType"/>
			<xs:element name="placeOfOrigin" type="eCH-0011:placeOfOriginType" maxOccurs="unbounded"/>
			<xs:element name="deliveryAddress" type="eCH-0010:mailAddressType"/>
			<xs:element name="residenceCountry" type="eCH-0008:countryType"/>
			<xs:element name="languageOfCorrespondance" type="eCH-0011:languageType" minOccurs="0"/>
			<xs:element name="registrationDate" type="eCH-0246:registrationDateType"/>
			<xs:element name="foreignAgencyAddress" type="eCH-0010:mailAddressType" minOccurs="0"/>
			<xs:element name="emailAddress" type="eCH-0246:emailAddressType" minOccurs="0"/>
			<xs:element ref="eCH-0246:extension" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="deregistrationReasonType">
		<xs:restriction base="xs:token">
			<xs:enumeration value="abandonment"/>
			<xs:enumeration value="death"/>
			<xs:enumeration value="missing"/>
			<xs:enumeration value="moving to Switzerland"/>
			<xs:enumeration value="general deputyship"/>
			<xs:enumeration value="loss of citizenship"/>
			<xs:enumeration value="3 times Documents undeliverable"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="votingRightDeregistrationType">
		<xs:sequence>
			<xs:element name="deregistrationReason" type="eCH-0246:deregistrationReasonType"/>
			<xs:element name="personIdentification" type="eCH-0044:personIdentificationType"/>
			<xs:element name="nameData" type="eCH-0011:nameDataType"/>
			<xs:element name="deregistrationDate" type="eCH-0246:registrationDateType"/>
			<xs:element ref="eCH-0246:extension" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="eVeraMutationPersonDataType">
		<xs:sequence>
			<xs:element name="personIdentification" type="eCH-0044:personIdentificationType"/>
			<xs:element name="nameData" type="eCH-0011:nameDataType"/>
			<xs:element name="birthData" type="eCH-0011:birthDataType"/>
			<xs:element name="placeOfOrigin" type="eCH-0011:placeOfOriginType" maxOccurs="unbounded"/>
			<xs:element name="deliveryAddress" type="eCH-0010:mailAddressType"/>
			<xs:element name="residenceCountry" type="eCH-0008:countryType"/>
			<xs:element name="languageOfCorrespondance" type="eCH-0011:languageType" minOccurs="0"/>
			<xs:element name="registrationDate" type="eCH-0246:registrationDateType"/>
			<xs:element name="foreignAgencyAddress" type="eCH-0010:mailAddressType"/>
			<xs:element name="emailAddress" type="eCH-0246:emailAddressType" minOccurs="0"/>
			<xs:element ref="eCH-0246:extension" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="votingRegisterMutationPersonDataType">
		<xs:sequence>
			<xs:element name="personIdentification" type="eCH-0044:personIdentificationType"/>
			<xs:element name="deliveryAddress" type="eCH-0010:mailAddressType" minOccurs="0"/>
			<xs:element name="languageOfCorrespondance" type="eCH-0011:languageType" minOccurs="0"/>
			<xs:element name="emailAddress" type="eCH-0246:emailAddressType" minOccurs="0"/>
			<xs:element ref="eCH-0246:extension" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="deliveryType">
		<xs:sequence>
			<xs:element name="deliveryHeader" type="eCH-0058:headerType"/>
			<xs:choice>
				<xs:element name="baseDelivery" type="eCH-0246:baseDeliveryType"/>
				<xs:element name="votingRightRegistration" type="eCH-0246:votingRightRegistrationType"/>
				<xs:element name="votingRightDeregistration" type="eCH-0246:votingRightDeregistrationType"/>
				<xs:element name="eVeraMutationPersonData" type="eCH-0246:eVeraMutationPersonDataType"/>
				<xs:element name="votingRegisterMutationPersonData" type="eCH-0246:votingRegisterMutationPersonDataType"/>
			</xs:choice>
		</xs:sequence>
		<xs:attribute name="version" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:enumeration value="3.0"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="delivery" type="eCH-0246:deliveryType"/>
</xs:schema>
