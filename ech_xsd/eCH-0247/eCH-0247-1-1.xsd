<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:eCH-0247="http://www.ech.ch/xmlns/eCH-0247/1"
	xmlns:eCH-0058="http://www.ech.ch/xmlns/eCH-0058/5"
	xmlns:eCH-0155="http://www.ech.ch/xmlns/eCH-0155/5"
	targetNamespace="http://www.ech.ch/xmlns/eCH-0247/1" elementFormDefault="qualified"
	attributeFormDefault="unqualified" version="1.1">
	<xs:annotation>
