				<xs:complexType>
					<xs:sequence>
						<xs:element name="domainOfInfluence" type="eCH-0155:domainOfInfluenceType" />
						<xs:element name="countingCircle" type="eCH-0155:countingCircleType"
							maxOccurs="unbounded" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="contest" minOccurs="0">
