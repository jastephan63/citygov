			<xs:documentation>This attribute is used for indicating the minor version of an XML
				Schema instance in a standardized way. It SHOULD only appear on the document element
				of XML Schema instances.</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:complexType name="initialDeliveryType">
		<xs:sequence>
			<xs:element name="masterDoi" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="masterDomainOfInfluence"
							type="eCH-0155:domainOfInfluenceType" />
						<xs:element name="masterCC" type="eCH-0155:countingCircleType"
							maxOccurs="unbounded" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="contest" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="dateOfVoting" type="eCH-0155:dateOfVotingType"
