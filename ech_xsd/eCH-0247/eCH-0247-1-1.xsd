	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0155/5"
		schemaLocation="http://www.ech.ch/xmlns/eCH-0155/5/eCH-0155-5-2.xsd" />
	<xs:attribute name="minorVersion" type="xs:integer">
