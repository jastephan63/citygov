					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="extension" type="eCH-0155:extensionType" minOccurs="0" />
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="mappingDeliveryType">
