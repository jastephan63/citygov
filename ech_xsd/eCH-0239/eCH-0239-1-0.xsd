			<xs:pattern value="building"/>
			<xs:pattern value="authorities"/>
			<xs:pattern value="procurement"/>
			<xs:pattern value="education"/>
			<xs:pattern value="residents"/>
			<xs:pattern value="finances"/>
			<xs:pattern value="buildings and properties"/>
			<xs:pattern value="geoinformation"/>
			<xs:pattern value="juristication"/>
			<xs:pattern value="business processing"/>
			<xs:pattern value="health"/>
			<xs:pattern value="land register"/>
			<xs:pattern value="real estate"/>
			<xs:pattern value="information technology"/>
			<xs:pattern value="information"/>
			<xs:pattern value="infrastructure"/>
			<xs:pattern value="culture"/>
			<xs:pattern value="agriculture"/>
			<xs:pattern value="logistics"/>
			<xs:pattern value="personnel"/>
			<xs:pattern value="political rights"/>
			<xs:pattern value="ligislation"/>
			<xs:pattern value="security"/>
			<xs:pattern value="social affairs"/>
			<xs:pattern value="taxes"/>
			<xs:pattern value="animals"/>
			<xs:pattern value="environment"/>
			<xs:pattern value="organisations"/>
			<xs:pattern value="transport"/>
			<xs:pattern value="insurance"/>
			<xs:pattern value="economy"/>
