					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="baseDeliveryPersonInformationType">
		<xs:sequence>
			<xs:element name="person">
				<xs:complexType>
					<xs:choice>
						<xs:element name="naturalPersonIdentification" type="eCH-0044:personIdentificationLightType"/>
						<xs:element name="organisationIdentification" type="eCH-0239:organisationIdentificationType"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
			<xs:element name="addressInformation" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="registeredInDomain" type="eCH-0239:domainType" minOccurs="0"/>
						<xs:element name="registeredInRegistry" type="eCH-0239:registryType" minOccurs="0"/>
						<xs:element name="address" type="eCH-0239:addressType"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="emailInformation" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="registeredInDomain" type="eCH-0239:domainType" minOccurs="0"/>
						<xs:element name="registeredInRegistry" type="eCH-0239:registryType" minOccurs="0"/>
						<xs:element name="email" type="eCH-0239:emailType"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="addresstypeType">
		<xs:restriction base="xs:token">
			<xs:minLength value="2"/>
			<xs:maxLength value="6"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="addresstypeDescriptionType">
		<xs:complexContent>
			<xs:extension base="eCH-0239:freetextType"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="addressType">
		<xs:sequence>
			<xs:element name="addressIdentification" type="eCH-0239:idType" minOccurs="0"/>
			<xs:element name="addresstype" type="eCH-0239:addresstypeType"/>
			<xs:element name="addressTypeDescription" type="eCH-0239:addresstypeDescriptionType" minOccurs="0"/>
			<xs:element name="mailAddress">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="eCH-0010:mailAddressType">
							<xs:choice minOccurs="0">
								<xs:element name="naturalPersonIdentification" type="eCH-0044:personIdentificationLightType" minOccurs="0"/>
								<xs:element name="organisationIdentification" type="eCH-0239:organisationIdentificationType" minOccurs="0"/>
							</xs:choice>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="EGID" type="eCH-0011:EGIDType" minOccurs="0"/>
			<xs:element name="EWID" type="eCH-0011:EWIDType" minOccurs="0"/>
