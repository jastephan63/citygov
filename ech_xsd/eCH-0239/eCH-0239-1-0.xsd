			<xs:minLength value="1"/>
			<xs:maxLength value="15"/>
			<xs:enumeration value="new address"/>
			<xs:enumeration value="changed address"/>
			<xs:enumeration value="deleted address"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="freetextType">
		<xs:sequence maxOccurs="unbounded">
			<xs:element name="language" type="eCH-0239:languageType"/>
			<xs:element name="text">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:minLength value="1"/>
						<xs:maxLength value="200"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="identificationProfessionalSenderType">
		<xs:restriction base="eCH-0239:idType"/>
	</xs:simpleType>
	<xs:simpleType name="identificationProfessionalRecipientType">
		<xs:restriction base="eCH-0239:idType"/>
	</xs:simpleType>
	<xs:simpleType name="idCategoryType">
		<xs:restriction base="xs:token">
			<xs:maxLength value="100"/>
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="idType">
		<xs:restriction base="xs:token">
