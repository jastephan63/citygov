	</xs:complexType>
	<xs:complexType name="domainType">
		<xs:sequence>
			<xs:element name="localDomainId" type="eCH-0239:idType"/>
			<xs:choice>
				<xs:element name="knownDomainDesignation" type="eCH-0239:knownDomainDesignationType"/>
				<xs:element name="otherDomainDesignation" type="eCH-0239:otherDomainDesignationType"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="knownRegistryDesignationType">
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:maxLength value="200"/>
			<xs:enumeration value="BUR"/>
			<xs:enumeration value="residents register"/>
			<xs:enumeration value="HR"/>
			<xs:enumeration value="MwSt"/>
			<xs:enumeration value="NAD"/>
			<xs:enumeration value="PISA"/>
			<xs:enumeration value="SECO"/>
			<xs:enumeration value="serafe"/>
			<xs:enumeration value="tax register"/>
			<xs:enumeration value="voting and electoral register"/>
			<xs:enumeration value="UID"/>
			<xs:enumeration value="ZEMIS"/>
			<xs:enumeration value="AGR"/>
			<xs:enumeration value="MedReg"/>
			<xs:enumeration value="AHV"/>
			<xs:enumeration value="ZOLL"/>
			<xs:enumeration value="UPI"/>
			<xs:enumeration value="AMICUS"/>
			<xs:enumeration value="AGATE"/>
			<xs:enumeration value="INFOSTAR"/>
