	</xs:simpleType>
	<xs:complexType name="emailType">
		<xs:sequence>
			<xs:choice>
				<xs:element name="emailCategory" type="eCH-0239:emailCategoryType"/>
				<xs:element name="otherEmailCategory" type="eCH-0239:otherEmailCategoryType"/>
			</xs:choice>
			<xs:element name="emailAddress" type="eCH-0239:emailAddressType"/>
			<xs:element name="emailAddressValidFrom" type="xs:date" minOccurs="0"/>
			<xs:element name="emailAdressValidTill" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationIdentificationType">
		<xs:sequence>
			<xs:element name="uid" type="eCH-0097:uidStructureType" minOccurs="0"/>
			<xs:element name="localOrganisationId" type="eCH-0097:namedOrganisationIdType" minOccurs="0"/>
			<xs:element name="OtherOrganisationId" type="eCH-0097:namedOrganisationIdType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="organisationName" type="eCH-0097:organisationNameType"/>
			<xs:element name="organisationLegalName" type="eCH-0097:organisationNameType" minOccurs="0"/>
			<xs:element name="organisationAdditionalName" type="eCH-0097:organisationNameType" minOccurs="0"/>
			<xs:element name="legalForm" type="eCH-0097:legalFormType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="addressReceiptType">
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
			<xs:enumeration value="address adopted"/>
			<xs:enumeration value="address not adopted"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="baseMessageType">
		<xs:sequence>
			<xs:element name="sender">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="identificationProfessionalSender" type="eCH-0239:identificationProfessionalSenderType"/>
						<xs:element name="senderDomain" type="eCH-0239:domainType" minOccurs="0"/>
						<xs:element name="senderRegistry" type="eCH-0239:registryType" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="recipient">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="identificationProfessionalRecipient" type="eCH-0239:identificationProfessionalRecipientType"/>
						<xs:element name="recipientDomain" type="eCH-0239:domainType" minOccurs="0"/>
						<xs:element name="recipientRegistry" type="eCH-0239:registryType" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="baseDeliveryType">
		<xs:complexContent>
			<xs:extension base="eCH-0239:baseMessageType">
				<xs:sequence>
					<xs:element name="personInformation" type="eCH-0239:baseDeliveryPersonInformationType" maxOccurs="unbounded"/>
					<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="reportAddressType">
		<xs:complexContent>
			<xs:extension base="eCH-0239:baseMessageType">
				<xs:sequence>
					<xs:element name="personInformation" type="eCH-0239:personInformationType" maxOccurs="unbounded"/>
					<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="addressSelectionType">
		<xs:restriction base="xs:token">
			<xs:enumeration value="addressOnly"/>
			<xs:enumeration value="emailOnly"/>
			<xs:enumeration value="address and email"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="selectionCriteriaType">
		<xs:sequence>
			<xs:element name="addressSelection" type="eCH-0239:addressSelectionType"/>
			<xs:element name="person" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice>
						<xs:element name="naturalPersonIdentification" type="eCH-0044:personIdentificationLightType"/>
						<xs:element name="organisationIdentification" type="eCH-0239:organisationIdentificationType"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
			<xs:element name="addresstype" minOccurs="0" maxOccurs="unbounded">
				<xs:simpleType>
					<xs:restriction base="eCH-0239:addresstypeType">
						<xs:enumeration value="01"/>
						<xs:enumeration value="0101"/>
						<xs:enumeration value="0102"/>
						<xs:enumeration value="0199"/>
						<xs:enumeration value="02"/>
						<xs:enumeration value="0201"/>
						<xs:enumeration value="0202"/>
						<xs:enumeration value="0299"/>
						<xs:enumeration value="03"/>
						<xs:enumeration value="0301"/>
						<xs:enumeration value="0399"/>
						<xs:enumeration value="04"/>
						<xs:enumeration value="0499"/>
						<xs:enumeration value="99"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="emailCategoryInformation" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice>
						<xs:element name="emailCategory" type="eCH-0239:emailCategoryType"/>
						<xs:element name="otherEmailCategory" type="eCH-0239:otherEmailCategoryType"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="requestAddressType">
		<xs:complexContent>
			<xs:extension base="eCH-0239:baseMessageType">
				<xs:sequence>
					<xs:element name="selectionCriteria" type="eCH-0239:selectionCriteriaType"/>
					<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="receiptType">
		<xs:complexContent>
			<xs:extension base="eCH-0239:baseMessageType">
				<xs:sequence>
					<xs:element name="personInformation" maxOccurs="unbounded">
						<xs:complexType>
							<xs:sequence>
								<xs:choice>
									<xs:element name="naturalPersonIdentification" type="eCH-0044:personIdentificationType"/>
									<xs:element name="organisationIdentification" type="eCH-0239:organisationIdentificationType"/>
								</xs:choice>
								<xs:element name="addressInformation" minOccurs="0" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="addressIdentificationSender" type="eCH-0239:idType" minOccurs="0"/>
											<xs:element name="addressIdentificationRecipient" type="eCH-0239:idType" minOccurs="0"/>
											<xs:element name="addressReceipt" type="eCH-0239:addressReceiptType"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="emailInformation" minOccurs="0" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="emailAddress" type="eCH-0239:emailAddressType"/>
											<xs:element name="addressReceipt" type="eCH-0239:addressReceiptType"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:element name="delivery" type="eCH-0239:deliveryType"/>
	<xs:complexType name="deliveryType">
		<xs:sequence>
			<xs:element name="deliveryHeader" type="eCH-0058:headerType"/>
			<xs:choice>
				<xs:element name="baseDelivery" type="eCH-0239:baseDeliveryType"/>
				<xs:element name="requestAddress" type="eCH-0239:requestAddressType"/>
				<xs:element name="reportAddress" type="eCH-0239:reportAddressType"/>
				<xs:element name="receipt" type="eCH-0239:receiptType"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
