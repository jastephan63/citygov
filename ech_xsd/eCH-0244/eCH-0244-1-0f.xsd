	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0007-f/6" schemaLocation="http://www.ech.ch/xmlns/eCH-0007-f/6/eCH-0007-6-0f.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0011-f/8" schemaLocation="http://www.ech.ch/xmlns/eCH-0011-f/8/eCH-0011-8-1f.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0010-f/6" schemaLocation="http://www.ech.ch/xmlns/eCH-0010-f/6/eCH-0010-6-0f.xsd"/>
