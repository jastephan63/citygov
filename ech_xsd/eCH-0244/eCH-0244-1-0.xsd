<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:eCH-0244="http://www.ech.ch/xmlns/eCH-0244/1" xmlns:eCH-0007="http://www.ech.ch/xmlns/eCH-0007/6" xmlns:eCH-0010="http://www.ech.ch/xmlns/eCH-0010/6" xmlns:eCH-0011="http://www.ech.ch/xmlns/eCH-0011/8" xmlns:eCH-0021="http://www.ech.ch/xmlns/eCH-0021/7" xmlns:eCH-0044="http://www.ech.ch/xmlns/eCH-0044/4" xmlns:eCH-0046="http://www.ech.ch/xmlns/eCH-0046/5" xmlns:eCH-0058="http://www.ech.ch/xmlns/eCH-0058/5" xmlns:eCH-0097="http://www.ech.ch/xmlns/eCH-0097/4" xmlns:eCH-0098="http://www.ech.ch/xmlns/eCH-0098/4" targetNamespace="http://www.ech.ch/xmlns/eCH-0244/1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xs:annotation>
		<xs:documentation>Ausgabedatum: 31.01.2023</xs:documentation>
	</xs:annotation>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0007/6" schemaLocation="http://www.ech.ch/xmlns/eCH-0007/6/eCH-0007-6-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0011/8" schemaLocation="http://www.ech.ch/xmlns/eCH-0011/8/eCH-0011-8-1.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0010/6" schemaLocation="http://www.ech.ch/xmlns/eCH-0010/6/eCH-0010-6-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0021/7" schemaLocation="http://www.ech.ch/xmlns/eCH-0021/7/eCH-0021-7-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0044/4" schemaLocation="http://www.ech.ch/xmlns/eCH-0044/4/eCH-0044-4-1.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0046/5" schemaLocation="http://www.ech.ch/xmlns/eCH-0046/5/eCH-0046-5-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0058/5" schemaLocation="http://www.ech.ch/xmlns/eCH-0058/5/eCH-0058-5-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0097/4" schemaLocation="http://www.ech.ch/xmlns/eCH-0097/4/eCH-0097-4-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0098/4" schemaLocation="http://www.ech.ch/xmlns/eCH-0098/4/eCH-0098-4-0.xsd"/>
	<xs:complexType name="personInfoType">
		<xs:sequence>
			<xs:element name="personIdentificationLight" type="eCH-0044:personIdentificationLightType"/>
			<xs:element name="nameInfo" type="eCH-0244:nameInfoType"/>
			<xs:element name="birthInfo" type="eCH-0244:birthInfoType" minOccurs="0"/>
			<xs:element name="religionData" type="eCH-0011:religionDataType" minOccurs="0"/>
			<xs:element name="maritalInfo" type="eCH-0244:maritalInfoType" minOccurs="0"/>
			<xs:element name="nationalityData" type="eCH-0011:nationalityDataType" minOccurs="0"/>
			<xs:element name="deathData" type="eCH-0011:deathDataType" minOccurs="0"/>
			<xs:element name="contactData" type="eCH-0011:contactDataType" minOccurs="0"/>
			<xs:element name="personAdditionalData" type="eCH-0021:personAdditionalData" minOccurs="0"/>
			<xs:choice minOccurs="0">
				<xs:element name="placeOfOriginInfo" type="eCH-0244:placeOfOriginInfoType" maxOccurs="unbounded"/>
				<xs:element name="residencePermit" type="eCH-0011:residencePermitDataType"/>
			</xs:choice>
			<xs:element name="lockData" type="eCH-0021:lockDataType" minOccurs="0"/>
			<xs:element name="jobData" type="eCH-0021:jobDataType" minOccurs="0"/>
			<xs:element name="maritalRelationship" type="eCH-0021:maritalRelationshipType" minOccurs="0"/>
			<xs:element name="parentalRelationship" type="eCH-0021:parentalRelationshipType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="guardianRelationship" type="eCH-0021:guardianRelationshipType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:choice minOccurs="0">
				<xs:element name="hasMainResidence" type="eCH-0011:mainResidenceType"/>
				<xs:element name="hasSecondaryResidence" type="eCH-0011:secondaryResidenceType"/>
				<xs:element name="hasOtherResidence" type="eCH-0011:otherResidenceType"/>
			</xs:choice>
			<xs:element name="contact" type="eCH-0046:contactType" minOccurs="0"/>
			<xs:element name="personMailAddress" type="eCH-0244:personMailAddressInfoType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationIdentificationLightType">
		<xs:sequence>
			<xs:element name="uid" type="eCH-0097:uidStructureType" minOccurs="0"/>
			<xs:element name="localOrganisationId" type="eCH-0097:namedOrganisationIdType" minOccurs="0"/>
			<xs:element name="OtherOrganisationId" type="eCH-0097:namedOrganisationIdType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="organisationName" type="eCH-0097:organisationNameType"/>
			<xs:element name="organisationLegalName" type="eCH-0097:organisationNameType" minOccurs="0"/>
			<xs:element name="organisationAdditionalName" type="eCH-0097:organisationNameType" minOccurs="0"/>
			<xs:element name="legalForm" type="eCH-0097:legalFormType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="nameInfoType">
		<xs:sequence>
			<xs:element name="nameData" type="eCH-0011:nameDataType"/>
			<xs:element name="nameValidFrom" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="maritalInfoType">
		<xs:sequence>
			<xs:element name="maritalData" type="eCH-0011:maritalDataType"/>
			<xs:element name="maritalDataAddon" type="eCH-0021:maritalDataAddonType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="placeOfOriginInfoType">
		<xs:sequence>
			<xs:element name="placeOfOrigin" type="eCH-0011:placeOfOriginType"/>
			<xs:element name="placeOfOriginAddonData" type="eCH-0021:placeOfOriginAddonDataType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="birthInfoType">
		<xs:sequence>
			<xs:element name="birthData" type="eCH-0011:birthDataType"/>
			<xs:element name="birthAddonData" type="eCH-0021:birthAddonDataType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="personMailAddressInfoType">
		<xs:sequence>
			<xs:element name="personMailAddress" type="eCH-0010:personMailAddressType"/>
			<xs:element name="addressCategory" type="eCH-0244:freeKategoryTextType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="emailCategoryType">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="emailAddressType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="100"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+(\.[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+)*@[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+(\.[A-Za-zäöüÄÖÜàáâãåæçèéêëìíîïðñòóôõøùúûýþÿ0-9!#-'\*\+\-/=\?\^_`\{-~]+)*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="addressCategoryType">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="phoneCategoryType">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
			<xs:enumeration value="6"/>
			<xs:enumeration value="7"/>
			<xs:enumeration value="8"/>
			<xs:enumeration value="9"/>
			<xs:enumeration value="10"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="phoneNumberType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="20"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="\d{10,20}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="internetCategoryType">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="internetAddressType">
		<xs:restriction base="xs:token">
			<xs:maxLength value="100"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="http://.*"/>
			<xs:pattern value="https://.*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="freeKategoryTextType">
		<xs:restriction base="xs:token">
			<xs:maxLength value="100"/>
			<xs:whiteSpace value="collapse"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="dateRangeType">
		<xs:sequence>
			<xs:element name="dateFrom" type="xs:date" minOccurs="0"/>
			<xs:element name="dateTo" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationType">
		<xs:sequence>
			<xs:element name="organisationIdentification" type="eCH-0244:organisationIdentificationLightType"/>
			<xs:element name="uidBrancheText" type="eCH-0098:uidBrancheTextType" minOccurs="0"/>
			<xs:element name="NOGACode" type="eCH-0098:NOGACodeType" minOccurs="0"/>
			<xs:element name="foundation" type="eCH-0098:foundationType" minOccurs="0"/>
			<xs:element name="liquidation" type="eCH-0098:liquidationType" minOccurs="0"/>
			<xs:element name="address" type="eCH-0098:organisationAddressType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="contact" type="eCH-0046:contactType" minOccurs="0"/>
			<xs:element name="languageOfCorrespondance" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="eCH-0098:languageType">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationInfoType">
		<xs:sequence>
			<xs:element name="organisation" type="eCH-0244:organisationType"/>
			<xs:choice minOccurs="0">
				<xs:element name="hasMainResidence" type="eCH-0098:mainResidenceType"/>
				<xs:element name="hasSecondaryResidence" type="eCH-0098:secondaryResidenceType"/>
				<xs:element name="hasOtherResidence" type="eCH-0098:otherResidenceType"/>
			</xs:choice>
			<xs:element name="contactData" type="eCH-0011:contactDataType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="subjectInfoType">
		<xs:choice>
			<xs:element name="organisationInfo" type="eCH-0244:organisationInfoType"/>
			<xs:element name="personInfo" type="eCH-0244:personInfoType"/>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="baseDeliverySubjectType">
		<xs:sequence>
			<xs:choice>
				<xs:element name="subject" type="eCH-0244:subjectInfoType"/>
			</xs:choice>
			<xs:element name="recordValidFrom" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="numberOfSubjectsType">
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>
	<xs:complexType name="eventBaseDelivery">
		<xs:sequence>
			<xs:element name="subject" type="eCH-0244:baseDeliverySubjectType" maxOccurs="unbounded"/>
			<xs:element name="numberOfSubjects" type="eCH-0244:numberOfSubjectsType" minOccurs="0"/>
			<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="eventModifySubject">
		<xs:sequence>
			<xs:element name="subject" type="eCH-0244:subjectInfoType"/>
			<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="eventDeleteSubject">
		<xs:sequence>
			<xs:element name="subject">
				<xs:complexType>
					<xs:choice>
						<xs:element name="organisationIdentification" type="eCH-0244:organisationIdentificationLightType"/>
						<xs:element name="personIdentification" type="eCH-0044:personIdentificationLightType"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
			<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="eventKeyExchange">
		<xs:sequence>
			<xs:choice>
				<xs:element name="keyExchangePerson" type="eCH-0044:personIdentificationLightType"/>
				<xs:element name="keyExchangeOrganisation" type="eCH-0244:organisationIdentificationLightType"/>
			</xs:choice>
			<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="eventDataRequest">
		<xs:sequence>
			<xs:choice>
				<xs:element name="dataRequestPerson" type="eCH-0044:personIdentificationLightType"/>
				<xs:element name="dataRequestOrganisation" type="eCH-0244:organisationIdentificationLightType"/>
			</xs:choice>
			<xs:element name="dataValidFrom" type="xs:date" minOccurs="0"/>
			<xs:element name="extension" type="xs:anyType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="infoType">
		<xs:sequence>
			<xs:element name="code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="250"/>
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="textEnglish" type="eCH-0244:infoTextType" minOccurs="0"/>
			<xs:element name="textGerman" type="eCH-0244:infoTextType" minOccurs="0"/>
			<xs:element name="textFrench" type="eCH-0244:infoTextType" minOccurs="0"/>
			<xs:element name="textItalian" type="eCH-0244:infoTextType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="infoTextType">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="negativeReportType">
		<xs:sequence>
			<xs:element name="generalError" type="eCH-0244:infoType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="personError" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:choice>
							<xs:element name="personIdentification" type="eCH-0044:personIdentificationLightType"/>
							<xs:element name="organisationIdentification" type="eCH-0244:organisationIdentificationLightType"/>
						</xs:choice>
						<xs:element name="errorInfo" type="eCH-0244:infoType" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="positiveReportType">
		<xs:sequence>
			<xs:element name="generalResponse" type="eCH-0244:infoType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="personResponse" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:choice>
							<xs:element name="personIdentification" type="eCH-0044:personIdentificationLightType"/>
							<xs:element name="organisationIdentification" type="eCH-0244:organisationIdentificationLightType"/>
						</xs:choice>
						<xs:element name="response" type="eCH-0244:infoType" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="deliveryType">
		<xs:sequence>
			<xs:element name="deliveryHeader" type="eCH-0058:headerType"/>
			<xs:choice>
				<xs:element name="baseDelivery" type="eCH-0244:eventBaseDelivery"/>
				<xs:element name="modifySubject" type="eCH-0244:eventModifySubject"/>
				<xs:element name="deleteSubject" type="eCH-0244:eventDeleteSubject"/>
				<xs:element name="keyExchange">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="messages" type="eCH-0244:eventKeyExchange" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="dataRequest" type="eCH-0244:eventDataRequest"/>
				<xs:element name="extension" type="xs:anyType"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="delivery" type="eCH-0244:deliveryType"/>
</xs:schema>
