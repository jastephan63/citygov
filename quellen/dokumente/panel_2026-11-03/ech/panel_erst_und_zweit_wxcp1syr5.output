[{"form_id": 582, "erst": {"urteile": [{"art": "feld", "feld": "Im Brief aufgeführte Unterlagen", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0039", "element": "document", "grund": "Das Formular ist zusammen mit den im Begleitbrief verlangten Unterlagen einzureichen. Das sind eingereichte Dokumente, also das Container-Element document von eCH-0039 (contentType), wie bei anderen Feldern mit Unterlagen (z. B. «Eingereichte Unterlagen Mutter/Vater»)."}, {"art": "feld", "feld": "Gesuchsteller / in", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "person", "grund": "Zusammengesetztes Feld mit Familienname, Vorname, Mädchenfamilienname, Geburtsdatum/-ort, Wohnadresse und Staatsangehörigkeit. Der Container eCH-0011 person (personType) deckt nameData, birthData (inkl. Geburtsort) und nationalityData ab. eCH-0044 personIdentification hat keinen Geburtsort und keine Staatsangehörigkeit. Die Teilfelder werden einzeln beurteilt."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Familiename", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Amtlicher Familienname der gesuchstellenden Person, also officialName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Vorname", "urteil": "korrekt", "standard": "eCH-0044", "element": "firstName", "grund": "Der übernommene Wert eCH-0044 firstName ist der Vorname der gesuchstellenden Person und stimmt."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Mädchenfamilienname", "urteil": "besser", "standard": "eCH-0044", "element": "originalName", "grund": "Der Name vor der Heirat (Ledigname) ist in eCH-0044 originalName. Das entspricht der Praxis bei «Ledigname»/«Mädchenname»."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Geburtsdatum/-ort", "urteil": "besser", "standard": "eCH-0011", "element": "birthData", "grund": "Das Teilfeld verlangt Geburtsdatum UND Geburtsort auf einer Zeile («/-ort» bis zum Ende gelesen). eCH-0011 birthData (birthDataType) fasst genau dateOfBirth und placeOfBirth zusammen. Nur dateOfBirth würde den Ort weglassen."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "PLZ / Wohnort in CH", "urteil": "besser", "standard": "eCH-0010", "element": "swissZipCode", "grund": "Postleitzahl und Wohnort in der Schweiz. «in CH» legt die Schweizer PLZ fest: eCH-0010 swissZipCode (addressInformationType), wie in der Praxis bei «PLZ / Ort». Der Ort gehört zu town desselben Typs."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Strasse", "urteil": "besser", "standard": "eCH-0010", "element": "street", "grund": "Strasse der Wohnadresse, also eCH-0010 street (addressInformationType)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit der gesuchstellenden Person, also eCH-0011 nationalityData (personType). So ist es in der Databank durchgehend zugeordnet (29x)."}, {"art": "feld", "feld": "Geschlecht", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "sex", "grund": "Ankreuzfeld weiblich/männlich mit einem Codewert (keine Ja/Nein-Frage), also eCH-0044 sex."}, {"art": "feld", "feld": "Zivilstand (Gesuchsteller / in)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "maritalStatus", "grund": "Aktueller Zivilstand (ledig/verheiratet/getrennt/geschieden/verwitwet), also eCH-0011 maritalStatus wie in der Praxis. Hinweis: «getrennt» ist in eCH-0011 kein Zivilstandscode, sondern separationData."}, {"art": "feld", "feld": "Datum der Einreise (nur Ausländer/in)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "entryDate", "grund": "Datum der Einreise in die Schweiz einer ausländischen Person, also eCH-0011 entryDate (residencePermitDataType, Einreisedatum). Nicht arrivalDate: das ist der Zuzug in die Gemeinde."}, {"art": "feld", "feld": "Art der Bewilligung", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0006", "element": "residencePermit", "grund": "Ausländerausweis L/B/C angekreuzt. Die Codeliste residencePermitType von eCH-0006 enthält die Kategorien 07/02/03. So ist es in der Praxis bei «Bewilligungsart» zugeordnet."}, {"art": "feld", "feld": "Beruf", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": "eCH-0021", "element": "jobTitle", "grund": "Der übernommene Wert eCH-0021 jobTitle (jobDataType, Berufsbezeichnung) stimmt."}, {"art": "feld", "feld": "Arbeitgeber", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": "eCH-0021", "element": "employer", "grund": "Der übernommene Wert eCH-0021 employer (occupationDataType) stimmt."}, {"art": "feld", "feld": "Zukünftige/r Ehefrau / Ehemann", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "person", "grund": "Zusammengesetztes Feld zur künftigen Ehepartnerin bzw. zum künftigen Ehepartner: Namen, Geburtsdatum/-ort, Staatsangehörigkeit, Adresse im Ausland. Container eCH-0011 person wie bei «Ehefrau»/«Ehemann». eCH-0021 maritalRelationship passt nicht, weil die Ehe noch nicht besteht."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Familiename", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Amtlicher Familienname der künftigen Ehepartnerin bzw. des künftigen Ehepartners, also officialName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Vorname", "urteil": "besser", "standard": "eCH-0044", "element": "firstName", "grund": "Vorname der künftigen Ehepartnerin bzw. des künftigen Ehepartners, also firstName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Mädchenfamilienname", "urteil": "besser", "standard": "eCH-0044", "element": "originalName", "grund": "Name vor der Heirat (Ledigname), also eCH-0044 originalName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Geburtsdatum/-ort", "urteil": "besser", "standard": "eCH-0011", "element": "birthData", "grund": "Geburtsdatum und Geburtsort auf einer Zeile, also eCH-0011 birthData (dateOfBirth und placeOfBirth). Nur dateOfBirth würde den Ort weglassen."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit, also eCH-0011 nationalityData wie in der Praxis."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "PLZ / Wohnort im Ausland", "urteil": "besser", "standard": "eCH-0010", "element": "foreignZipCode", "grund": "Postleitzahl und Wohnort im Ausland. «im Ausland» legt die ausländische PLZ fest: eCH-0010 foreignZipCode (addressInformationType), nicht swissZipCode. Der Ort gehört zu town."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Strasse", "urteil": "besser", "standard": "eCH-0010", "element": "street", "grund": "Strasse der Wohnadresse im Ausland, also eCH-0010 street."}, {"art": "feld", "feld": "Zivilstand (Zukünftige/r Ehefrau / Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "maritalStatus", "grund": "Aktueller Zivilstand (ledig/geschieden/verwitwet), also eCH-0011 maritalStatus."}, {"art": "feld", "feld": "Mutter", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Das Formular verlangt nur Name(n) und Vorname(n) der Mutter. Das modelliert eCH-0021 als nameOfParent (nameOfParentType: officialName, firstName, typeOfRelationship). parentalRelationship ist die Beziehung zu einer identifizierten Person mit Adresse und Sorge. Praxis bei «Eltern», «Angaben zur Mutter»: nameOfParent."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Familienname der Mutter, also officialName in nameOfParentType (eCH-0021), wie bei «Eltern / Mutter: Name(n)»."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname(n) der Mutter, also firstName in nameOfParentType (eCH-0021)."}, {"art": "feld", "feld": "Vater", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Nur Name(n) und Vorname(n) des Vaters werden verlangt, also eCH-0021 nameOfParent (nameOfParentType). parentalRelationship ist die Beziehung zu einer identifizierten Person mit Sorge und Adresse."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Familienname des Vaters, also officialName in nameOfParentType (eCH-0021)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname(n) des Vaters, also firstName in nameOfParentType (eCH-0021)."}, {"art": "feld", "feld": "Bestehen Vorstrafen?", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu Vorstrafen, also kein Wert-Element. Der Basis-Datenkatalog Polizei und Justiz eCH-0051 (Genehmigt, ohne Element-Katalog) deckt das Thema ab. So ist es bei «Vorstrafen» auf den Formularen 34 und 497 zugeordnet."}, {"art": "feld", "feld": "Ist ein Strafverfahren hängig?", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu einem hängigen Strafverfahren, also kein Wert-Element. eCH-0051 (Genehmigt, 0 Elemente), wie bei «Hängiges Strafverfahren» auf den Formularen 214/216/220/497."}, {"art": "feld", "feld": "Bemerkungen", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": null, "element": null, "grund": "Freitext-Bemerkung. Der übernommene Wert kein_standard stimmt. eCH-0039 comment und eCH-0058 comment sind Metadaten zu Dokument bzw. Meldung, keine Bemerkung der gesuchstellenden Person."}, {"art": "feld", "feld": "CH-Vertretung", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Gemeint ist die Schweizer Auslandsvertretung (Botschaft/Konsulat), bei der das Visum beantragt wird. Gesucht im ganzen Katalog: Elementnamen/Kontexte mit represent/embass/consul/diplomat/visa/mission/vertretung, eCH-0223 (Einwohnerdienst–Migrationsamt) und eCH-0006. Es gibt nur Stellvertreter-Personen (eCH-0119 representativePerson, eCH-0229/eCH-0260 representative), keine diplomatische Vertretung. So ist auch «Schweizer Vertretung für Visumsabholung» (Formular 497) beurteilt."}, {"art": "feld", "feld": "Ort, Datum", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": "eCH-0119", "element": "locationAndDate", "grund": "Ort und Datum der Unterzeichnung. Der übernommene Wert eCH-0119 locationAndDate ist das einzige Katalog-Element für diese kombinierte Angabe. Die Databank hat es 19x so geprüft."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Ort", "urteil": "korrekt", "standard": null, "element": null, "grund": "Der übernommene Wert kein_standard stimmt. locationAndDate ist ein einziger String ohne Teile. Kein Element im Katalog definiert den Ort der Unterzeichnung allein (gesucht: sign*, location*)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Datum", "urteil": "korrekt", "standard": null, "element": null, "grund": "Der übernommene Wert kein_standard stimmt. Ein Element für das Datum der Unterzeichnung gibt es im Katalog nicht. eCH-0039 openingDate und eCH-0058 messageDate haben eine andere Bedeutung."}, {"art": "feld", "feld": "Unterschrift Gesuchsteller/in", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Eigenhändige Unterschrift. Im ganzen Katalog nach *sign* gesucht: Gefunden wurden nur eCH-0039 signer (Metadatum zum Dokument) und eCH-0260 signatures (Ja/Nein-Bestätigungen im Lehrvertrag). Keines davon ist die Unterschrift. So sind die anderen Unterschriftsfelder beurteilt (98x kein_standard)."}]}, "zweit": {"urteile": [{"art": "feld", "feld": "Im Brief aufgeführte Unterlagen", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0039", "element": "document", "grund": "Die im Begleitbrief verlangten Unterlagen sind zusammen mit dem Formular einzureichen (data_type attachment). Ein eingereichtes Dokument ist das Element document von eCH-0039 (contentType, documentType). So sind auch «Eingereichte Unterlagen Mutter/Vater», «Beilagedokumente» und «Belege» zugeordnet. Geprüft: Das Element steht wörtlich im Katalog, eCH-0039 ist genehmigt."}, {"art": "feld", "feld": "Gesuchsteller / in", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "person", "grund": "Zusammengesetztes Feld mit Familienname, Vorname, Mädchenfamilienname, Geburtsdatum/-ort, Wohnadresse in der Schweiz und Staatsangehörigkeit. Der Container eCH-0011 person (reportedPersonType, personType) umfasst nameData, birthData mit Geburtsort und nationalityData. eCH-0044 personIdentification enthält weder Geburtsort noch Staatsangehörigkeit. So ist es auch bei «Ehefrau»/«Ehemann» zugeordnet. Die Teilfelder werden einzeln beurteilt."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Familiename", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Amtlicher Familienname der gesuchstellenden Person: eCH-0044 officialName (personIdentificationType)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Vorname", "urteil": "korrekt", "standard": "eCH-0044", "element": "firstName", "grund": "Die Databank hat eCH-0044 firstName übernommen. Das ist der Vorname der gesuchstellenden Person, die Zuordnung stimmt."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Mädchenfamilienname", "urteil": "besser", "standard": "eCH-0044", "element": "originalName", "grund": "Gemeint ist der Name vor der Heirat (Ledigname): eCH-0044 originalName. So sind auch «Ledigname» und «Mädchenname» zugeordnet."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Geburtsdatum/-ort", "urteil": "besser", "standard": "eCH-0011", "element": "birthData", "grund": "Bis zum Ende gelesen verlangt das Teilfeld Geburtsdatum UND Geburtsort auf einer Zeile («/-ort»). eCH-0011 birthData (birthDataType) fasst dateOfBirth und placeOfBirth zusammen, so steht es in der XSD eCH-0011-9-0. Mit dateOfBirth allein, wie es bei anderen Formularen zugeordnet ist, ginge der Ort verloren."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "PLZ / Wohnort in CH", "urteil": "besser", "standard": "eCH-0010", "element": "swissZipCode", "grund": "Postleitzahl und Wohnort in der Schweiz. Wegen «in CH» ist es die Schweizer Postleitzahl: eCH-0010 swissZipCode (addressInformationType). So sind auch «PLZ / Wohnort» und «PLZ / Ort» zugeordnet. Der Ort gehört zu town desselben Typs."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Strasse", "urteil": "besser", "standard": "eCH-0010", "element": "street", "grund": "Strasse der Wohnadresse in der Schweiz: eCH-0010 street (addressInformationType)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Gesuchsteller / in", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit der gesuchstellenden Person: eCH-0011 nationalityData (personType). So ist es in der Databank durchgehend zugeordnet (29x)."}, {"art": "feld", "feld": "Geschlecht", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "sex", "grund": "Ankreuzfeld weiblich/männlich. Das ist ein Codewert und keine Ja/Nein-Frage: eCH-0044 sex (personIdentificationType)."}, {"art": "feld", "feld": "Zivilstand (Gesuchsteller / in)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "maritalStatus", "grund": "Aktueller Zivilstand (ledig/verheiratet/getrennt/geschieden/verwitwet): eCH-0011 maritalStatus (maritalDataType). Hinweis: «getrennt» ist in eCH-0011 kein Zivilstandscode, sondern gehört zu separationData."}, {"art": "feld", "feld": "Datum der Einreise (nur Ausländer/in)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "entryDate", "grund": "Datum der Einreise einer ausländischen Person in die Schweiz: eCH-0011 entryDate (residencePermitDataType, Einreisedatum). Das ist ein Ereignisdatum und kein aktueller Wert. arrivalDate passt nicht, es bezeichnet den Zuzug in die Gemeinde."}, {"art": "feld", "feld": "Art der Bewilligung", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0006", "element": "residencePermit", "grund": "Angekreuzt wird der Ausländerausweis L/B/C, den die gesuchstellende Person besitzt. Die Codeliste residencePermitType von eCH-0006 enthält die Kategorien 07/02/03 (geprüft in eCH-0006-3-0.xsd). So sind auch «Bewilligungsart», «Ausländerausweis» und «Aufenthaltsbewilligung Typ» zugeordnet. residencePermitCategory wäre gleichwertig, aber residencePermit ist die übliche Zuordnung."}, {"art": "feld", "feld": "Beruf", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": "eCH-0021", "element": "jobTitle", "grund": "Die Databank hat eCH-0021 jobTitle (jobDataType, Berufsbezeichnung) übernommen. Die Zuordnung stimmt."}, {"art": "feld", "feld": "Arbeitgeber", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": "eCH-0021", "element": "employer", "grund": "Die Databank hat eCH-0021 employer (occupationDataType) übernommen. Die Zuordnung stimmt."}, {"art": "feld", "feld": "Zukünftige/r Ehefrau / Ehemann", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "person", "grund": "Zusammengesetztes Feld zur künftigen Ehepartnerin bzw. zum künftigen Ehepartner: Namen, Geburtsdatum/-ort, Staatsangehörigkeit und Adresse im Ausland. Container ist eCH-0011 person, wie bei «Ehefrau»/«Ehemann». eCH-0021 maritalRelationship passt nicht, weil die Ehe noch nicht besteht."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Familiename", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Amtlicher Familienname der künftigen Ehepartnerin bzw. des künftigen Ehepartners: eCH-0044 officialName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Vorname", "urteil": "besser", "standard": "eCH-0044", "element": "firstName", "grund": "Vorname der künftigen Ehepartnerin bzw. des künftigen Ehepartners: eCH-0044 firstName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Mädchenfamilienname", "urteil": "besser", "standard": "eCH-0044", "element": "originalName", "grund": "Name vor der Heirat (Ledigname): eCH-0044 originalName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Geburtsdatum/-ort", "urteil": "besser", "standard": "eCH-0011", "element": "birthData", "grund": "Geburtsdatum und Geburtsort stehen auf einer Zeile: eCH-0011 birthData (birthDataType mit dateOfBirth und placeOfBirth). Mit dateOfBirth allein ginge der Ort verloren."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit: eCH-0011 nationalityData (personType), so wie es in der Databank üblich ist."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "PLZ / Wohnort im Ausland", "urteil": "besser", "standard": "eCH-0010", "element": "foreignZipCode", "grund": "Postleitzahl und Wohnort im Ausland. Wegen «im Ausland» ist es die ausländische Postleitzahl: eCH-0010 foreignZipCode (addressInformationType) und nicht swissZipCode. So ist es auch bei «Wohnadresse im Ausland: PLZ / Ort» zugeordnet. Der Ort gehört zu town."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Strasse", "urteil": "besser", "standard": "eCH-0010", "element": "street", "grund": "Strasse der Wohnadresse im Ausland: eCH-0010 street (addressInformationType)."}, {"art": "feld", "feld": "Zivilstand (Zukünftige/r Ehefrau / Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "maritalStatus", "grund": "Aktueller Zivilstand (ledig/geschieden/verwitwet): eCH-0011 maritalStatus (maritalDataType)."}, {"art": "feld", "feld": "Mutter", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Die Databank hat parentalRelationship übernommen, das passt nicht. Verlangt sind nur Name(n) und Vorname(n) der Mutter. Das bildet eCH-0021 als nameOfParent ab (birthAddonDataType, nameOfParentType: officialName, firstName, typeOfRelationship). parentalRelationship beschreibt die Beziehung zu einer identifizierten Person mit Adresse und Sorgerecht, wie bei den Formularen 289/546, wo Geburtsdatum, Heimatort und Wohnort verlangt werden. Gleich gestaltet ist Formular 497 desselben Amts, dort sind «Mutter: Name(n)/Vorname(n)» nameOfParent-Teilen zugeordnet."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Familienname der Mutter: officialName in nameOfParentType (eCH-0021), wie bei «Eltern / Mutter: Name(n)» auf Formular 497."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname(n) der Mutter: firstName in nameOfParentType (eCH-0021), wie auf Formular 497."}, {"art": "feld", "feld": "Vater", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Die Databank hat parentalRelationship übernommen, das passt nicht. Verlangt sind nur Name(n) und Vorname(n) des Vaters: eCH-0021 nameOfParent (nameOfParentType). parentalRelationship beschreibt die Beziehung zu einer identifizierten Person mit Sorgerecht und Adresse. Formular 497 desselben Amts ist gleich zugeordnet."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Familienname des Vaters: officialName in nameOfParentType (eCH-0021)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname(n) des Vaters: firstName in nameOfParentType (eCH-0021)."}, {"art": "feld", "feld": "Bestehen Vorstrafen?", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu Vorstrafen, deshalb kein Wert-Element. Das Thema deckt der Basis-Datenkatalog Polizei und Justiz eCH-0051 ab (Genehmigt, ohne Element-Katalog, n_elements=0). So ist auch «Vorstrafen» auf den Formularen 34 und 497 zugeordnet."}, {"art": "feld", "feld": "Ist ein Strafverfahren hängig?", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu einem hängigen Strafverfahren, deshalb kein Wert-Element. Standard ist eCH-0051 (Genehmigt, 0 Elemente), wie bei «Hängiges Strafverfahren» auf den Formularen 214/216/220/497."}, {"art": "feld", "feld": "Bemerkungen", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": null, "element": null, "grund": "Freitext-Bemerkung. Die Databank hat kein_standard übernommen, das stimmt (84x so geprüft). eCH-0039 comment und eCH-0058 comment sind Metadaten zu einem Dokument bzw. einer Meldung, keine Bemerkung der gesuchstellenden Person."}, {"art": "feld", "feld": "CH-Vertretung", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Gemeint ist die schweizerische Auslandsvertretung (Botschaft/Konsulat). Im ganzen Katalog gesucht: Elementnamen und Kontexte mit embass/consul/diplomat/visa/mission/representation/abroad, Standardtitel mit Ausland/Vertretung/Visum/Migration/Konsul/Zivilstand, die XSDs nach vertretung/embassy/consul. Gefunden wurden nur eCH-0045/0228 swissAbroad (Auslandschweizer als Stimmberechtigte), eCH-0136 officeType (Zivilstandsämter des Heimatorts), eCH-0223 (Einwohnerdienst–Migrationsamt, ohne Vertretung) und Stellvertreter-Personen (eCH-0119 representativePerson, eCH-0278 contactAndRepresentation). Keines davon ist eine diplomatische Vertretung. So ist auch «Schweizer Vertretung für Visumsabholung» auf Formular 497 beurteilt."}, {"art": "feld", "feld": "Ort, Datum", "elternfeld": null, "teilfeld": null, "urteil": "korrekt", "standard": "eCH-0119", "element": "locationAndDate", "grund": "Ort und Datum der Unterzeichnung. Die Databank hat eCH-0119 locationAndDate übernommen. Das ist das einzige Katalog-Element für diese kombinierte Angabe und ist 19x so geprüft."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Ort", "urteil": "korrekt", "standard": null, "element": null, "grund": "Die Databank hat kein_standard übernommen, das stimmt (46x so geprüft). locationAndDate ist ein einziger String ohne Teile. Kein Element im Katalog bezeichnet nur den Ort der Unterzeichnung (gesucht: sign*, location*). eCH-0010 town ist ein Adressteil."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Datum", "urteil": "korrekt", "standard": null, "element": null, "grund": "Die Databank hat kein_standard übernommen, das stimmt (46x so geprüft). Für das Datum der Unterzeichnung gibt es im Katalog kein Element. eCH-0039 openingDate und eCH-0058 messageDate bedeuten etwas anderes."}, {"art": "feld", "feld": "Unterschrift Gesuchsteller/in", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Eigenhändige Unterschrift. Im ganzen Katalog nach *sign* gesucht. Gefunden wurden nur eCH-0039 signer (Metadatum zum Dokument) und eCH-0260 signatures (Ja/Nein-Bestätigungen im Lehrvertrag). Keines davon ist die Unterschrift selbst. So sind auch die anderen Unterschriftsfelder beurteilt (98x kein_standard)."}]}}, {"form_id": 583, "erst": {"urteile": [{"art": "feld", "feld": "Zukünftige/r Ehefrau / Ehemann", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "person", "grund": "Der Block fasst die Personalien der zukünftigen Ehefrau oder des zukünftigen Ehemanns zusammen: Familienname, Vorname, Geburtsdatum, Staatsangehörigkeit und Wohnadresse im Ausland. Ein Container-Element existiert: eCH-0011 person (personType, Genehmigt). Es umfasst Identifikation, Namen, Geburtsdaten und Staatsangehörigkeit. So wurden auch «Ehefrau» und «Ehemann» auf den Formularen 548 und 549 zugeordnet. eCH-0021 maritalRelationship scheidet aus, weil noch keine Ehe besteht: Die Heirat wird erst vorbereitet."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Familienname", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Amtlicher Familienname der zukünftigen Ehepartnerin oder des zukünftigen Ehepartners. Zuordnung nach der Regel Name → officialName, wie im Korpus (33-mal eCH-0044 officialName)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Vorname", "urteil": "besser", "standard": "eCH-0044", "element": "firstName", "grund": "Vorname der zukünftigen Ehepartnerin oder des zukünftigen Ehepartners. Zuordnung nach der Regel Vorname → firstName, wie im Korpus (249-mal eCH-0044 firstName)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Geburtsdatum", "urteil": "besser", "standard": "eCH-0044", "element": "dateOfBirth", "grund": "Geburtsdatum der Person (Feld _._._). Zuordnung nach der Regel Geburtsdatum → dateOfBirth, wie im Korpus (239-mal eCH-0044 dateOfBirth)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit der zukünftigen Ehepartnerin oder des zukünftigen Ehepartners, also die aktuelle Angabe. Im Katalog entspricht ihr eCH-0011 nationalityData (personType, Genehmigt). Das ist auch die einheitliche Zuordnung im Korpus (29-mal)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "PLZ / Wohnort im Ausland", "urteil": "besser", "standard": "eCH-0010", "element": "foreignZipCode", "grund": "Postleitzahl und Wohnort der Adresse im Ausland. Der Teil bündelt PLZ und Ort (eCH-0010 town). Wie im Korpus nimmt er das Element des führenden Bestandteils. Weil die Adresse ausdrücklich im Ausland liegt, ist das die ausländische PLZ eCH-0010 foreignZipCode (addressInformationType) und nicht swissZipCode. So wurde «PLZ/Ort» auch bei Zustelladresse und Adresse im Tollwut-Risikoland zugeordnet."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Strasse", "urteil": "besser", "standard": "eCH-0010", "element": "street", "grund": "Strasse der Wohnadresse im Ausland. Zuordnung nach der Regel Strasse → eCH-0010 street (addressInformationType), wie im Korpus (134-mal)."}, {"art": "feld", "feld": "Ort, Datum", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ort und Datum der Unterzeichnung der Garantieerklärung beim Migrationsamt. Den propagierten Wert eCH-0119 locationAndDate bestätige ich nicht. Das Element gehört zu E-Tax Filing und kommt nur in attachedFormsType und listOfSecuritiesType vor, also bei Beilagen zur Steuererklärung und beim Wertschriftenverzeichnis. Für eine ausländerrechtliche Garantieerklärung definiert es die Angabe nicht. Steuer-Elemente wie eCH-0119 firstName werden im Korpus ausserhalb von Steuerformularen ebenfalls nicht verwendet. Die gleichartigen Migrationsamt-Formulare 497 und 508–513 führen «Ort und Datum» als kein_standard. Durchsuchter Katalog: Elementnamen mit sign, place, location und date in allen Standards. Treffer: nur eCH-0011/0020/0021-Orte wie Geburtsort, Heimatort und Heiratsort, eCH-0119 location (concernedPersonType, Steuer) und eCH-0039 signer (token für Unterzeichner, ohne Ort und Datum). Durchsuchte Standardtitel: Signatur und Unterschrift. Die Treffer eCH-0091, 0220, 0230, 0250, 0274 und 0282 sind technische Normen ohne Elemente. Kein Element in Kraft bildet Ort oder Datum einer Unterzeichnung allgemein ab. Hinweis: Derselbe Einwand gilt für die übrigen «Ort, Datum»-Zeilen mit eCH-0119; das liegt ausserhalb dieses Formulars."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Ort", "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ort der Unterzeichnung. Im ganzen Katalog wurden Elemente mit place, location und sign gesucht. Gefunden wurden nur Geburts-, Heimat-, Heirats- und Arbeitsorte (eCH-0011/0020/0021/0119), Steuer-Orte (eCH-0119 location, concernedPersonType) und Adress- bzw. Grundstücksorte (eCH-0010/0129/0131). Ein Element für den Ort einer Unterzeichnung fehlt. Das deckt sich mit dem Korpus (34-mal kein_standard)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Datum", "urteil": "kein_standard", "standard": null, "element": null, "grund": "Datum der Unterzeichnung. Gesucht wurden Elemente mit date und sign. Gefunden wurden nur fachspezifische Daten wie eCH-0039 openingDate (Dokumenteröffnung), Melde- und Zeitstempel in Registermeldungen sowie eCH-0119 paymentDate und transactionDate. Ein Element für das Datum einer Unterzeichnung fehlt. Das deckt sich mit dem Korpus (34-mal kein_standard)."}, {"art": "feld", "feld": "Unterschrift Gesuchsteller/in", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Eigenhändige Unterschrift der garantierenden Person. Gesucht wurden Elementnamen mit sign und unterschrift sowie Standardtitel mit Signatur und Unterschrift. Treffer: eCH-0039 signer, ein Token für den Unterzeichner eines GEVER-Dokuments und keine Unterschrift. Dazu kommen eCH-0091, 0220, 0230, 0250, 0274 und 0282: technische Normen zu elektronischen Signaturen, alle ohne Elemente und ohne Bezug zu einer handschriftlichen Unterschrift. Das deckt sich mit der einheitlichen Praxis im Korpus (rund 100 Unterschriftsfelder kein_standard)."}]}, "zweit": {"urteile": [{"art": "feld", "feld": "Zukünftige/r Ehefrau / Ehemann", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "person", "grund": "Der Block enthält die Personalien der zukünftigen Ehefrau oder des zukünftigen Ehemanns: Familienname, Vorname, Geburtsdatum, Staatsangehörigkeit und Wohnadresse im Ausland. Als Container gibt es eCH-0011 person (reportedPersonType, Datentyp personType, Genehmigt). Er umfasst Identifikation, Namen, Geburt und Staatsangehörigkeit. Gleich zugeordnet sind «Ehefrau» und «Ehemann» auf den Formularen 548 und 549. eCH-0021 maritalRelationship passt nicht, weil noch keine Ehe besteht; die Heirat wird erst vorbereitet. eCH-0044 personIdentification enthält keine Staatsangehörigkeit. eCH-0223 personData betrifft Meldungen zwischen Einwohnerdienst und Migrationsamt mit Schweizer Adresse und passt hier nicht."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Familienname", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Amtlicher Familienname der zukünftigen Ehepartnerin oder des zukünftigen Ehepartners. Regel Name → officialName. Das Element steht in eCH-0044 (personIdentificationType und personIdentificationLightType). So ist «Familienname» im Korpus am häufigsten zugeordnet (33-mal)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Vorname", "urteil": "besser", "standard": "eCH-0044", "element": "firstName", "grund": "Vorname der zukünftigen Ehepartnerin oder des zukünftigen Ehepartners. Regel Vorname → firstName (eCH-0044, personIdentificationType). So ist «Vorname» im Korpus vorherrschend zugeordnet (251-mal)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Geburtsdatum", "urteil": "besser", "standard": "eCH-0044", "element": "dateOfBirth", "grund": "Geburtsdatum der zukünftigen Ehepartnerin oder des zukünftigen Ehepartners, Eingabe im Format _._._. Regel Geburtsdatum → dateOfBirth (eCH-0044, datePartiallyKnownType). Im Korpus 240-mal so zugeordnet."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Aktuelle Staatsangehörigkeit der zukünftigen Ehepartnerin oder des zukünftigen Ehepartners. Es geht um keinen früheren oder geänderten Wert. Dafür steht eCH-0011 nationalityData (personType, Genehmigt). Das ist die einheitliche Zuordnung im Korpus (29-mal), auch auf den Migrationsamt-Formularen 508 bis 513."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "PLZ / Wohnort im Ausland", "urteil": "besser", "standard": "eCH-0010", "element": "foreignZipCode", "grund": "Postleitzahl und Wohnort der Adresse im Ausland in einer Zeile. Wie bei «PLZ / Wohnort» im Korpus erhält der Teil das Element seines ersten Bestandteils, der PLZ (sonst 295-mal swissZipCode). Die Adresse liegt laut Formular ausdrücklich im Ausland. Darum passt eCH-0010 foreignZipCode (addressInformationType) und nicht swissZipCode. Bei ausländischen PLZ/Ort-Teilen ist das im Korpus fünfmal so gemacht."}, {"art": "teilfeld", "feld": null, "elternfeld": "Zukünftige/r Ehefrau / Ehemann", "teilfeld": "Strasse", "urteil": "besser", "standard": "eCH-0010", "element": "street", "grund": "Strasse der Wohnadresse im Ausland. Regel Strasse → eCH-0010 street (addressInformationType). Dieser Typ gilt für Schweizer und ausländische Adressen; swissAddressInformationType gilt nur für Schweizer Adressen. Im Korpus 134-mal so zugeordnet."}, {"art": "feld", "feld": "Ort, Datum", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ort und Datum der Unterzeichnung der Garantieerklärung mit Schuldanerkennung nach Art. 82 SchKG. Den propagierten Wert eCH-0119 locationAndDate bestätige ich nicht. Laut XSD eCH-0119-4-0-0 ist das Element ein freier Text. Es steht nur in attachedFormsType (neben attachedExpenses und attachedFreeText) und in listOfSecuritiesType. Es ist also die Unterschriftszeile der Steuererklärung und ihres Wertschriftenverzeichnisses. Anders als ibanNumber oder accountOwner, die auch ausserhalb von Steuerformularen verwendet werden, ist das Element an das Steuerdokument gebunden. Eine ausländerrechtliche Garantieerklärung definiert es nicht. Die Zahl «19x geprüft» spiegelt eine Spaltung im Korpus nach Wortlaut, nicht nach Bedeutung. «Ort, Datum» ist 15-mal mit locationAndDate zugeordnet. Dieselbe Angabe unter «Ort und Datum» ist rund 29-mal kein_standard, auch auf den Migrationsamt-Formularen 497, 508–510, 512 und 513. Im ganzen Katalog wurden Elementnamen mit sign, location, place, declaration, issueDate und placeAnd gesucht, dazu Standardtitel mit Signatur und Unterschrift. Treffer: eCH-0039 signer (Token für die unterzeichnende Person, ohne Ort und Datum), eCH-0119 location (concernedPersonType, Steuer) und eCH-0260 signatures (Ja/Nein-Bestätigungen im Lehrvertrag). Hinzu kommen die technischen Signaturnormen eCH-0091, 0220, 0230, 0250, 0274 und 0282 ohne Elemente. Kein Element eines gültigen Standards bildet Ort und Datum einer Unterzeichnung allgemein ab. Hinweis: Dieselbe Frage stellt sich beim Schwesterformular 582 und bei den übrigen «Ort, Datum»-Zeilen mit locationAndDate. Das liegt ausserhalb dieses Formulars."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Ort", "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ort der Unterzeichnung, also weder Adresse noch Wohnort. Das propagierte kein_standard bestätige ich. Im ganzen Katalog wurde nach location, place und sign gesucht. Gefunden wurden nur Orte mit anderer Bedeutung: Geburts-, Heimat-, Heirats- und Arbeitsort (eCH-0011/0021), eCH-0119 location (Steuer), Adress- und Gebäudeorte (eCH-0010 town, eCH-0108, eCH-0129, eCH-0211) und eCH-0262 locationOfUtilisation. eCH-0119 locationAndDate ist ein ungeteilter Text ohne eigenen Ort. Im Korpus ist der Teil «Ort» unter «Ort, Datum» bzw. «Ort und Datum» durchgehend kein_standard (46-mal)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort, Datum", "teilfeld": "Datum", "urteil": "kein_standard", "standard": null, "element": null, "grund": "Datum der Unterzeichnung der Garantieerklärung. Das propagierte kein_standard bestätige ich. Gesucht wurden Datumselemente mit date, sign, declaration, application und request. Gefunden wurden nur fachgebundene Daten: eCH-0039 openingDate (Eröffnung eines Dossiers), eCH-0206 requestDate und eCH-0058 messageDate (Zeitstempel elektronischer Meldungen), eCH-0216 Baudaten und eCH-0262 dateOfApplication (Pflanzenschutz). Keines bezeichnet das Datum, an dem eine Person eine Erklärung unterschreibt. Im Korpus ist der Teil «Datum» unter «Ort, Datum» bzw. «Ort und Datum» durchgehend kein_standard (46-mal)."}, {"art": "feld", "feld": "Unterschrift Gesuchsteller/in", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Eigenhändige Unterschrift der garantierenden Person. Gesucht wurden Elementnamen mit sign und Signatur sowie Standardtitel mit Signatur und Unterschrift. Treffer: eCH-0039 signer, ein Token für die unterzeichnende Person eines GEVER-Dokuments und keine Unterschrift. eCH-0260 hostCompany-, apprentice- und representativeSignatureConfirmation sind Ja/Nein-Werte im Lehrvertrag. eCH-0091, 0220, 0230, 0250, 0274 und 0282 sind technische Normen zu elektronischen Signaturen ohne Elemente. Kein Element passt. Das entspricht der einheitlichen Praxis im Korpus: 98 Unterschriftsfelder sind kein_standard."}]}}, {"form_id": 584, "erst": {"urteile": [{"art": "feld", "feld": "ZEMIS Nr. der Gesuchstellerin/des Gesuchstellers", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "otherPersonId", "grund": "ZEMIS-Nummer = vom SEM vergebener Personenidentifikator (nicht AHV); eCH-0044 otherPersonId (namedPersonIdType mit personIdCategory) – wie A1 (497) und 506–513."}, {"art": "feld", "feld": "Name und Adresse der Gesuchstellerin/des Gesuchstellers", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "personIdentification", "grund": "Komposit (Familienname, Vorname, Geburtsdatum, Adresse, Staatsangehörigkeit) erhält das Container-Element eCH-0044 personIdentification wie A1 (497); Teile einzeln beurteilt."}, {"art": "teilfeld", "feld": null, "elternfeld": "Name und Adresse der Gesuchstellerin/des Gesuchstellers", "teilfeld": "Familienname(n)", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Familienname = amtlicher Name, eCH-0044 officialName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Name und Adresse der Gesuchstellerin/des Gesuchstellers", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0044", "element": "firstName", "grund": "Vorname(n) = eCH-0044 firstName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Name und Adresse der Gesuchstellerin/des Gesuchstellers", "teilfeld": "Geburtsdatum", "urteil": "besser", "standard": "eCH-0044", "element": "dateOfBirth", "grund": "Geburtsdatum = eCH-0044 dateOfBirth."}, {"art": "teilfeld", "feld": null, "elternfeld": "Name und Adresse der Gesuchstellerin/des Gesuchstellers", "teilfeld": "Adresse", "urteil": "besser", "standard": "eCH-0010", "element": "addressInformation", "grund": "Freitext-Adresse der gesuchstellenden Person = eCH-0010 addressInformation (Adressblock ohne getrennte Teile auf dem Formular), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Name und Adresse der Gesuchstellerin/des Gesuchstellers", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit = eCH-0011 nationalityData, wie A1 (497)."}, {"art": "feld", "feld": "Personalien der Familienangehörigen, deren Nachzug gewünscht wird (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "personIdentification", "grund": "Komposit Personalien (Name, Vorname, Geburtsdatum, Geburtsort, Geburtsland, Staatsangehörigkeit) erhält Container eCH-0044 personIdentification wie A1 (497); Teile einzeln beurteilt."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Familienangehörigen, deren Nachzug gewünscht wird (Ehefrau/Ehemann)", "teilfeld": "Familienname(n)", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Familienname = amtlicher Name, eCH-0044 officialName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Familienangehörigen, deren Nachzug gewünscht wird (Ehefrau/Ehemann)", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0044", "element": "firstName", "grund": "Vorname(n) = eCH-0044 firstName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Familienangehörigen, deren Nachzug gewünscht wird (Ehefrau/Ehemann)", "teilfeld": "Geburtsdatum", "urteil": "besser", "standard": "eCH-0044", "element": "dateOfBirth", "grund": "Geburtsdatum = eCH-0044 dateOfBirth."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Familienangehörigen, deren Nachzug gewünscht wird (Ehefrau/Ehemann)", "teilfeld": "Geburtsort", "urteil": "besser", "standard": "eCH-0011", "element": "placeOfBirth", "grund": "Geburtsort = eCH-0011 placeOfBirth (birthDataType), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Familienangehörigen, deren Nachzug gewünscht wird (Ehefrau/Ehemann)", "teilfeld": "Geburtsland", "urteil": "besser", "standard": "eCH-0011", "element": "country", "grund": "Geburtsland = Staat des Geburtsorts, eCH-0011 country (generalPlaceType/foreignCountry, Staatencode eCH-0008), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Familienangehörigen, deren Nachzug gewünscht wird (Ehefrau/Ehemann)", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit = eCH-0011 nationalityData, wie A1 (497)."}, {"art": "feld", "feld": "Geschlecht (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "sex", "grund": "Ankreuzwahl männlich/weiblich = Wert des Geschlechts (sexType 1/2), keine Ja/Nein-Box; eCH-0044 sex wie A1 (497)."}, {"art": "feld", "feld": "Mutter (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Komposit Name(n)/Vorname(n) der Mutter = eCH-0021 nameOfParent (birthAddonDataType, typeOfRelationship 3) wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter (Ehefrau/Ehemann)", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Name des Elternteils = eCH-0021 officialName (nameOfParentType), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter (Ehefrau/Ehemann)", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname des Elternteils = eCH-0021 firstName (nameOfParentType), wie A1 (497)."}, {"art": "feld", "feld": "Vater (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Komposit Name(n)/Vorname(n) des Vaters = eCH-0021 nameOfParent (birthAddonDataType, typeOfRelationship 4) wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater (Ehefrau/Ehemann)", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Name des Elternteils = eCH-0021 officialName (nameOfParentType), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater (Ehefrau/Ehemann)", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname des Elternteils = eCH-0021 firstName (nameOfParentType), wie A1 (497)."}, {"art": "feld", "feld": "Strafverfahren hängig (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu Strafverfahren/Vorstrafen: kein eCH-Element im Katalog (criminal/convict/penal/offence ohne Treffer); fachlicher Standard ist eCH-0051 Basis-Datenkatalog Polizei und Justiz (Genehmigt, ohne Elementkatalog) – wie bei A1 (Formular 497) und den Formularen 34/214/216/220."}, {"art": "feld", "feld": "Vorstrafen (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu Strafverfahren/Vorstrafen: kein eCH-Element im Katalog (criminal/convict/penal/offence ohne Treffer); fachlicher Standard ist eCH-0051 Basis-Datenkatalog Polizei und Justiz (Genehmigt, ohne Elementkatalog) – wie bei A1 (Formular 497) und den Formularen 34/214/216/220."}, {"art": "feld", "feld": "Ist die Einreise bereits erfolgt? (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ja/Nein-Feld: eCH-0011 entryDate ist ein Wertelement (Datum) und darf eine Ja/Nein-Box nicht tragen; ganzer Katalog nach boolean/yesNo-Elementen zur Einreise durchsucht (eCH-0011, eCH-0223, eCH-0093; eCH-0041 «Einreise mit Arbeitsbewilligung» hat keine Elemente und betrifft Arbeitsbewilligung, nicht Familiennachzug) – nichts gefunden."}, {"art": "feld", "feld": "Falls ja, wann (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "entryDate", "grund": "Datum der bereits erfolgten Einreise in die Schweiz = eCH-0011 entryDate (residencePermitDataType, Einreisedatum); ein vergangenes Ereignisdatum, kein aktueller Bewilligungswert."}, {"art": "feld", "feld": "Gegenwärtige Aufenthaltsadresse (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0010", "element": "addressInformation", "grund": "Freitext-Adresse des gegenwärtigen Aufenthalts (CH oder Ausland) = eCH-0010 addressInformation, wie «Adresse (gegenwärtige Aufenthaltsadresse)» auf A1 (497)."}, {"art": "feld", "feld": "Pass / ID (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ganzer Katalog (290 Standards) durchsucht: kein eCH-Element für die Art des Reise-/Ausweisdokuments in eCH-0011/0021/0044/0093/0223; documentType in eCH-0078/0102/0119/0229/0260 meint Beilagen bzw. Steuerdokumente; eCH-0084 shownDocument (UPI-Meldung an die ZAS, Codes 211/214/217 ohne Dokumentation im XSD) ist nicht als Code für Pass vs. ID belegbar. Ankreuzwahl Pass/ID bleibt ohne Standard."}, {"art": "feld", "feld": "gültig bis (Ehefrau/Ehemann)", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ganzer Katalog durchsucht (validTill/validTo/validUntil/expiry/document): Gültigkeitsdaten gibt es nur für Bewilligung (eCH-0011 residencePermitValidTill), Sperren, Kontakt, Trennung, Biometriedaten (eCH-0093 biometricDataExpiryDate) – kein Element für das Ablaufdatum von Pass/ID. Das «gültig bis» gehört zum Pass/ID, nicht zur Bewilligung."}, {"art": "feld", "feld": "Ort und Datum", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Komposit Ort/Datum der Unterzeichnung: eCH-0119 locationAndDate existiert nur in Steuerkontexten (attachedFormsType, listOfSecuritiesType), eCH-0260 signatures nur im Lehrvertrag; sonst im ganzen Katalog kein Element für Unterzeichnungsort/-datum – wie die Mehrheit der Formulare (23)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort und Datum", "teilfeld": "Ort", "urteil": "kein_standard", "standard": null, "element": null, "grund": "Unterzeichnungsort: kein eCH-Element ausserhalb des Steuerkontexts (eCH-0119 locationAndDate nur in attachedFormsType/listOfSecuritiesType); ganzer Katalog nach Ort/Datum der Unterzeichnung durchsucht."}, {"art": "teilfeld", "feld": null, "elternfeld": "Ort und Datum", "teilfeld": "Datum", "urteil": "kein_standard", "standard": null, "element": null, "grund": "Unterzeichnungsdatum: kein eCH-Element ausserhalb des Steuerkontexts (eCH-0119 locationAndDate nur Steuer; eCH-0260 signatures nur Lehrvertrag); ganzer Katalog durchsucht."}, {"art": "feld", "feld": "Unterschrift der Gesuchstellerin/des Gesuchstellers", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Eigenhändige Unterschrift: ganzer Katalog nach signat*/signing durchsucht – nur eCH-0260 signatures/…SignatureConfirmation (Lehrvertrag) und Signatur-Verfahrensstandards ohne Elemente (eCH-0091/0220/0230/0250/0274/0282); kein Datenelement für die Unterschrift einer Gesuchstellerin."}, {"art": "feld", "feld": "Verwandtschaftsverhältnis zur Gesuchstellerin/zum Gesuchsteller (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "typeOfRelationship", "grund": "Ankreuzwahl Kind/Vater/Mutter/Anderes = Art der Beziehung zur gesuchstellenden Person; eCH-0021 typeOfRelationship (parentalRelationshipType, Codes 3/4 Mutter/Vater bzw. Kindesverhältnis invers); «Anderes» hat keinen Code – Codeliste deckt nur Eltern-Kind."}, {"art": "feld", "feld": "Personalien der Personen, welche in die Schweiz einreisen sollen (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "personIdentification", "grund": "Komposit Personalien (Name, Vorname, Geburtsdatum, Geburtsort, Geburtsland, Staatsangehörigkeit) erhält Container eCH-0044 personIdentification wie A1 (497); Teile einzeln beurteilt."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Personen, welche in die Schweiz einreisen sollen (Person 1)", "teilfeld": "Familienname(n)", "urteil": "besser", "standard": "eCH-0044", "element": "officialName", "grund": "Familienname = amtlicher Name, eCH-0044 officialName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Personen, welche in die Schweiz einreisen sollen (Person 1)", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0044", "element": "firstName", "grund": "Vorname(n) = eCH-0044 firstName."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Personen, welche in die Schweiz einreisen sollen (Person 1)", "teilfeld": "Geburtsdatum", "urteil": "besser", "standard": "eCH-0044", "element": "dateOfBirth", "grund": "Geburtsdatum = eCH-0044 dateOfBirth."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Personen, welche in die Schweiz einreisen sollen (Person 1)", "teilfeld": "Geburtsort", "urteil": "besser", "standard": "eCH-0011", "element": "placeOfBirth", "grund": "Geburtsort = eCH-0011 placeOfBirth (birthDataType), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Personen, welche in die Schweiz einreisen sollen (Person 1)", "teilfeld": "Geburtsland", "urteil": "besser", "standard": "eCH-0011", "element": "country", "grund": "Geburtsland = Staat des Geburtsorts, eCH-0011 country (generalPlaceType/foreignCountry, Staatencode eCH-0008), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Personalien der Personen, welche in die Schweiz einreisen sollen (Person 1)", "teilfeld": "Staatsangehörigkeit", "urteil": "besser", "standard": "eCH-0011", "element": "nationalityData", "grund": "Staatsangehörigkeit = eCH-0011 nationalityData, wie A1 (497)."}, {"art": "feld", "feld": "Geschlecht (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0044", "element": "sex", "grund": "Ankreuzwahl männlich/weiblich = Wert des Geschlechts (sexType 1/2), keine Ja/Nein-Box; eCH-0044 sex wie A1 (497)."}, {"art": "feld", "feld": "Mutter (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Komposit Name(n)/Vorname(n) der Mutter = eCH-0021 nameOfParent (birthAddonDataType, typeOfRelationship 3) wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter (Person 1)", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Name des Elternteils = eCH-0021 officialName (nameOfParentType), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Mutter (Person 1)", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname des Elternteils = eCH-0021 firstName (nameOfParentType), wie A1 (497)."}, {"art": "feld", "feld": "Vater (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0021", "element": "nameOfParent", "grund": "Komposit Name(n)/Vorname(n) des Vaters = eCH-0021 nameOfParent (birthAddonDataType, typeOfRelationship 4) wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater (Person 1)", "teilfeld": "Name(n)", "urteil": "besser", "standard": "eCH-0021", "element": "officialName", "grund": "Name des Elternteils = eCH-0021 officialName (nameOfParentType), wie A1 (497)."}, {"art": "teilfeld", "feld": null, "elternfeld": "Vater (Person 1)", "teilfeld": "Vorname(n)", "urteil": "besser", "standard": "eCH-0021", "element": "firstName", "grund": "Vorname des Elternteils = eCH-0021 firstName (nameOfParentType), wie A1 (497)."}, {"art": "feld", "feld": "Pass / ID (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ganzer Katalog (290 Standards) durchsucht: kein eCH-Element für die Art des Reise-/Ausweisdokuments in eCH-0011/0021/0044/0093/0223; documentType in eCH-0078/0102/0119/0229/0260 meint Beilagen bzw. Steuerdokumente; eCH-0084 shownDocument (UPI-Meldung an die ZAS, Codes 211/214/217 ohne Dokumentation im XSD) ist nicht als Code für Pass vs. ID belegbar. Ankreuzwahl Pass/ID bleibt ohne Standard."}, {"art": "feld", "feld": "gültig bis (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ganzer Katalog durchsucht (validTill/validTo/validUntil/expiry/document): Gültigkeitsdaten gibt es nur für Bewilligung (eCH-0011 residencePermitValidTill), Sperren, Kontakt, Trennung, Biometriedaten (eCH-0093 biometricDataExpiryDate) – kein Element für das Ablaufdatum von Pass/ID. Das «gültig bis» gehört zum Pass/ID, nicht zur Bewilligung."}, {"art": "feld", "feld": "Strafverfahren hängig (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu Strafverfahren/Vorstrafen: kein eCH-Element im Katalog (criminal/convict/penal/offence ohne Treffer); fachlicher Standard ist eCH-0051 Basis-Datenkatalog Polizei und Justiz (Genehmigt, ohne Elementkatalog) – wie bei A1 (Formular 497) und den Formularen 34/214/216/220."}, {"art": "feld", "feld": "Vorstrafen (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0051", "element": null, "grund": "Ja/Nein-Frage zu Strafverfahren/Vorstrafen: kein eCH-Element im Katalog (criminal/convict/penal/offence ohne Treffer); fachlicher Standard ist eCH-0051 Basis-Datenkatalog Polizei und Justiz (Genehmigt, ohne Elementkatalog) – wie bei A1 (Formular 497) und den Formularen 34/214/216/220."}, {"art": "feld", "feld": "Ist die Einreise bereits erfolgt (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "kein_standard", "standard": null, "element": null, "grund": "Ja/Nein-Feld: eCH-0011 entryDate ist ein Wertelement (Datum) und darf eine Ja/Nein-Box nicht tragen; ganzer Katalog nach boolean/yesNo-Elementen zur Einreise durchsucht (eCH-0011, eCH-0223, eCH-0093; eCH-0041 «Einreise mit Arbeitsbewilligung» hat keine Elemente und betrifft Arbeitsbewilligung, nicht Familiennachzug) – nichts gefunden."}, {"art": "feld", "feld": "Falls ja, wann (Person 1)", "elternfeld": null, "teilfeld": null, "urteil": "besser", "standard": "eCH-0011", "element": "entryDate", "grund": "Datum der bereits erfolgten Einreise in die Schweiz = eCH-0011 entryDate (residencePermitDataType, Einreisedatum); ein verg